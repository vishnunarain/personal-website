---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'imhotep — Vishnu Unnikrishnan',
  description = 'Work, systems, and field notes by Vishnu Unnikrishnan.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="header-wrap">
      <div class="shell">
        <header class="site-header">
          <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>imhotep</a>
          <nav class="nav" aria-label="Primary">
            <a href="/#work">work</a>
            <a href="/field-notes">writing</a>
            <a href="/#systems">systems</a>
            <a href="/identity">about</a>
          </nav>
        </header>
      </div>
    </div>
    <main><slot /></main>
    <div class="shell">
      <footer class="footer">
        <div class="footer-main">
          <div>
            <div class="footer-person">Vishnu Unnikrishnan</div>
            <div class="footer-role">work · systems · field notes</div>
          </div>
          <div class="footer-links"><a href="/#work">work</a><a href="/field-notes">writing</a><a href="/identity">about</a></div>
        </div>
        <div class="hieroglyph-signature" title="Imhotep signature" aria-label="Imhotep hieroglyphic signature">𓇋𓇋𓅓𓊵𓏏𓊪</div>
      </footer>
    </div>
  </body>
</html>
