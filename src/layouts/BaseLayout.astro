---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "imhotep — Notes from a restless mind",
  description = "An illustrated journal about building things, thinking across disciplines, and occasionally checking whether the Nile still works. By Vishnu Unnikrishnan.",
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7ef" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to the story
    </a>
    <header class="masthead shell">
      <div class="masthead-top">
        <span>AN INDEPENDENT JOURNAL</span>
        <a href="/identity">BY VISHNU UNNIKRISHNAN ↗</a>
      </div>
      <div class="nameplate">
        <a href="/" aria-label="imhotep home">
          imhotep<span class="brand-dot">.</span>
        </a>
        <p>
          A restless mind.
          <br />A very long to-do list.
        </p>
      </div>
      <nav aria-label="Main navigation">
        <div class="nav-links">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>
            Front page
          </a>
          <a
            href="/field-notes"
            aria-current={path.startsWith("/field-notes") ? "page" : undefined}
          >
            The journal
          </a>
          <a href="/imho" aria-current={path === "/imho" ? "page" : undefined}>
            Marginalia
          </a>
          <a href="/tep" aria-current={path === "/tep" ? "page" : undefined}>
            The work
          </a>
        </div>
        <span class="nav-aside">ENGINEERING · DESIGN · EVERYTHING ELSE</span>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="shell footer">
      <a class="footer-brand" href="/">
        imhotep.
      </a>
      <p>Made by Vishnu. Blame the scribe for the rest.</p>
      <a href="/identity">The person behind the papyrus ↗</a>
    </footer>
  </body>
</html>
