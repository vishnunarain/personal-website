---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'imhotep — Vishnu Unnikrishnan',
  description = 'Work, systems, opinions, and field notes by Vishnu Unnikrishnan.'
} = Astro.props;

const path = Astro.url.pathname;
const isImho = path.startsWith('/imho');
const isTep = path.startsWith('/tep');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="header-wrap">
      <div class="shell">
        <header class="site-header nav-axis">
          <a class:list={['axis-link','axis-left', {active:isImho}]} href="/imho" aria-label="Go to IMHO">
            <span class="axis-key">←</span>
            <span>imho</span>
          </a>

          <a class="axis-brand" href="/" aria-label="Go to imhotep home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>imhotep</span>
          </a>

          <a class:list={['axis-link','axis-right', {active:isTep}]} href="/tep" aria-label="Go to TEP">
            <span>tep</span>
            <span class="axis-key">→</span>
          </a>
        </header>
      </div>
    </div>

    <main><slot /></main>

    <div class="shell">
      <footer class="footer">
        <div class="footer-main">
          <div>
            <div class="footer-person">Vishnu Unnikrishnan</div>
            <div class="footer-role">work · systems · field notes</div>
          </div>
          <div class="footer-links"><a href="/imho">imho</a><a href="/">imhotep</a><a href="/tep">tep</a></div>
        </div>
        <div class="hieroglyph-signature" title="Imhotep signature" aria-label="Imhotep hieroglyphic signature">𓇋𓇋𓅓𓊵𓏏𓊪</div>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const path = window.location.pathname;
        const targetFor = (key) => {
          if (path.startsWith('/imho')) return key === 'ArrowRight' ? '/' : null;
          if (path.startsWith('/tep')) return key === 'ArrowLeft' ? '/' : null;
          return key === 'ArrowLeft' ? '/imho' : key === 'ArrowRight' ? '/tep' : null;
        };

        window.addEventListener('keydown', (event) => {
          const tag = document.activeElement?.tagName?.toLowerCase();
          if (tag === 'input' || tag === 'textarea' || document.activeElement?.isContentEditable) return;
          const target = targetFor(event.key);
          if (!target) return;
          event.preventDefault();
          document.body.classList.add(event.key === 'ArrowLeft' ? 'page-leave-left' : 'page-leave-right');
          window.setTimeout(() => { window.location.href = target; }, 110);
        });
      })();
    </script>
  </body>
</html>
