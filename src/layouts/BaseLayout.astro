---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'imhotep — Vishnu Unnikrishnan',
  description = 'Vishnu Unnikrishnan — engineering leader and systems builder across supply chain, healthcare, and scalable software.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/">imhotep</a>
        <nav aria-label="Primary">
          <a href="/#work">work</a>
          <a href="/field-notes">field notes</a>
          <a href="/#systems">systems</a>
          <a href="/identity">identity</a>
        </nav>
      </header>
      <main><slot /></main>
    </div>
    <footer>
      <div class="shell footer-inner">
        <span>© {new Date().getFullYear()} Vishnu Unnikrishnan</span>
        <span>built as an evolving field notebook</span>
      </div>
      <div class="signature" aria-label="Imhotep hieroglyphic signature">𓇋𓅓𓊵𓏏𓊪</div>
    </footer>
  </body>
</html>
