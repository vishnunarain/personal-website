---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('fieldNotes', ({data}) => !data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const fmt = (d: Date) => new Intl.DateTimeFormat('en', { year:'numeric', month:'short', day:'numeric' }).format(d);
---
<BaseLayout title="field notes — imhotep">
  <section class="section">
    <div class="section-head">
      <div class="eyebrow">field notes</div>
      <h2>Systems, decisions, and what changed my mind.</h2>
    </div>
    <div class="notes-list">
      {notes.map(note => (
        <a class="note-row" href={`/field-notes/${note.id}/`}>
          <time>{fmt(note.data.publishedAt)}</time>
          <div>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
          </div>
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
