---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemThumb from '../components/SystemThumb.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('fieldNotes', ({ data }) => !data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0,6);

const fmt = (d: Date) => new Intl.DateTimeFormat('en', {year:'numeric', month:'short'}).format(d);
---
<BaseLayout>
  <section class="workbench shell">
    <div class="wb-kicker">selected work / field notes / working models</div>
    <div class="wb-axis" aria-hidden="true">
      <span>01</span><span>02</span><span>03</span><span>04</span>
    </div>
    <div class="wb-title">
      <span>systems</span>
      <span>decisions</span>
      <span>interfaces</span>
    </div>
    <div class="wb-note">
      <span class="pyramid-cursor"></span>
      a reading surface, not a résumé
    </div>
  </section>

  <section class="shell work-terraces" id="work">
    <article class="terrace terrace-a">
      <div class="terrace-meta"><span class="dot dot-supply"></span><span>01 / supply chain</span></div>
      <div class="terrace-copy">
        <h2>Decision systems for global operations</h2>
        <p>Visibility, disruption, risk, emissions, reporting, and the product architecture required to make many systems feel like one.</p>
        <a href="/#work">open case →</a>
      </div>
      <div class="terrace-thumb"><SystemThumb type="supply" /></div>
    </article>

    <article class="terrace terrace-b">
      <div class="terrace-meta"><span class="dot dot-health"></span><span>02 / healthcare</span></div>
      <div class="terrace-copy">
        <h2>Software where correctness has human consequences</h2>
        <p>Healthcare work shaped how I think about reliability, clarity, workflow design, and the cost of ambiguity.</p>
        <a href="/identity">trace the thread →</a>
      </div>
      <div class="terrace-thumb"><SystemThumb type="health" /></div>
    </article>

    <article class="terrace terrace-c" id="systems">
      <div class="terrace-meta"><span class="dot dot-systems"></span><span>03 / systems</span></div>
      <div class="terrace-copy">
        <h2>Architecture that survives the next order of magnitude</h2>
        <p>Distributed systems, APIs, event flows, data models, frontend federation, and the decisions that keep complexity proportional to scale.</p>
        <a href="/identity">system notes →</a>
      </div>
      <div class="terrace-thumb"><SystemThumb type="platform" /></div>
    </article>
  </section>

  <section class="shell cross-section">
    <div class="cross-label">working principles</div>
    <div class="principle-map">
      <div class="principle p1"><span>▲</span><strong>Make complexity earn its place.</strong><p>The sophisticated solution is not automatically the senior one.</p></div>
      <div class="principle p2"><span>▲</span><strong>Expose decisions, not org structure.</strong><p>Users should not need to understand service boundaries.</p></div>
      <div class="principle p3"><span>▲</span><strong>Leadership is part of the system.</strong><p>Context, feedback, ownership, and incentives shape output.</p></div>
      <div class="principle p4"><span>▲</span><strong>Taste compounds.</strong><p>Teams improve when they can explain why something is clear and useful.</p></div>
    </div>
  </section>

  <section class="shell reading-map">
    <div class="reading-head">
      <div>field notes</div>
      <a href="/field-notes">all notes →</a>
    </div>
    <div class="reading-canvas">
      {notes.map((note, i) => (
        <a class={`note-card note-${i+1}`} href={`/field-notes/${note.id}/`}>
          <div class="note-topline"><span>{fmt(note.data.originallyWrittenAt ?? note.data.publishedAt)}</span><span>{note.data.tags[0] ?? 'note'}</span></div>
          <h3>{note.data.title}</h3>
          <p>{note.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell end-cap">
    <div class="end-cap-mark" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="end-cap-copy">
      <span>current thread</span>
      <p>AI-native engineering workflows, calmer decision interfaces, and stronger engineering systems with less ceremony.</p>
    </div>
    <a href="/identity">context →</a>
  </section>
</BaseLayout>
