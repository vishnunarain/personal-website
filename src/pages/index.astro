---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemThumb from '../components/SystemThumb.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('fieldNotes', ({ data }) => !data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const recentNotes = notes.slice(0,5);
const fmt = (d: Date) => new Intl.DateTimeFormat('en', {year:'numeric', month:'short'}).format(d);
---
<BaseLayout>
  <div class="reading-room shell">
    <section class="feature-artifact">
      <div class="artifact-label">Featured work</div>
      <div class="artifact-main">
        <div class="artifact-copy">
          <div class="artifact-meta">Supply chain / product systems / architecture</div>
          <h1>Making operational complexity legible.</h1>
          <p>How visibility, risk, emissions, reporting, and shipment state can become one coherent decision surface instead of a collection of product boundaries.</p>
          <a href="/#deep-dives">Read the case →</a>
        </div>
        <div class="artifact-visual">
          <SystemThumb type="supply" />
        </div>
      </div>
    </section>

    <section class="room-grid">
      <div class="room-lane" id="deep-dives">
        <div class="lane-head">
          <span>Deep dives</span>
          <span>03</span>
        </div>

        <article class="lane-item lane-item-large">
          <div class="lane-type">Case study</div>
          <h2>Decision systems for global operations</h2>
          <p>Designing across disruptions, shipments, orders, risk, emissions, and reporting without forcing the user to understand the machinery underneath.</p>
          <a href="/#work">open →</a>
        </article>

        <article class="lane-item">
          <div class="lane-type">System note</div>
          <h3>Architecture that survives the next order of magnitude</h3>
          <p>Where boundaries, caching, orchestration, and data ownership start to matter.</p>
          <a href="/identity">open →</a>
        </article>

        <article class="lane-item">
          <div class="lane-type">Retrospective</div>
          <h3>What healthcare software taught me about correctness</h3>
          <p>Why clarity, traceability, and operational discipline are product concerns.</p>
          <a href="/identity">open →</a>
        </article>
      </div>

      <div class="room-lane">
        <div class="lane-head">
          <span>Field notes</span>
          <a href="/field-notes">all</a>
        </div>
        {recentNotes.map((note) => (
          <a class="note-line" href={`/field-notes/${note.id}/`}>
            <div class="note-line-date">{fmt(note.data.originallyWrittenAt ?? note.data.publishedAt)}</div>
            <div>
              <h3>{note.data.title}</h3>
              <p>{note.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="room-lane">
        <div class="lane-head">
          <span>On the bench</span>
          <span>current</span>
        </div>

        <article class="bench-item">
          <div class="bench-tag">AI engineering</div>
          <h3>Growing an AI intern into an engineer</h3>
          <p>Context, review, task design, memory, and the boundary between delegation and abdication.</p>
        </article>

        <article class="bench-item">
          <div class="bench-tag">Interfaces</div>
          <h3>Calm decision surfaces</h3>
          <p>How much operational complexity can a product absorb before the user has to see it?</p>
        </article>

        <article class="bench-item">
          <div class="bench-tag">Teams</div>
          <h3>Building taste as an engineering capability</h3>
          <p>Shared vocabulary, critique, customer framing, and why quality becomes cultural.</p>
        </article>

        <article class="bench-item bench-item-visual">
          <SystemThumb type="platform" />
        </article>
      </div>
    </section>

    <section class="archive-index">
      <div class="archive-head">
        <span>Browse the archive</span>
        <span>by thread</span>
      </div>
      <div class="archive-links">
        <a href="/field-notes">systems <span>→</span></a>
        <a href="/field-notes">product design <span>→</span></a>
        <a href="/field-notes">engineering leadership <span>→</span></a>
        <a href="/field-notes">AI + agents <span>→</span></a>
        <a href="/field-notes">supply chain <span>→</span></a>
        <a href="/field-notes">healthcare <span>→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
