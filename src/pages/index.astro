---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemThumb from '../components/SystemThumb.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('fieldNotes', ({ data }) => !data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0,6);

const fmt = (d: Date) => new Intl.DateTimeFormat('en', {year:'numeric', month:'short'}).format(d);
---
<BaseLayout>
  <section class="index-open shell">
    <div class="terminal-line"><span class="pyramid-cursor" aria-hidden="true"></span><span>index / selected work + notes</span></div>
    <div class="index-grid">
      <a href="/#work" class="index-link">
        <span class="index-code">01</span>
        <span>work</span>
        <span class="index-desc">systems, products, decisions</span>
      </a>
      <a href="/field-notes" class="index-link">
        <span class="index-code">02</span>
        <span>field notes</span>
        <span class="index-desc">writing, experiments, unfinished thinking</span>
      </a>
      <a href="/#systems" class="index-link">
        <span class="index-code">03</span>
        <span>systems</span>
        <span class="index-desc">architecture, scale, operating models</span>
      </a>
      <a href="/identity" class="index-link">
        <span class="index-code">04</span>
        <span>about</span>
        <span class="index-desc">Vishnu, briefly</span>
      </a>
    </div>
  </section>

  <section class="section shell rule compact-section" id="work">
    <div class="section-label stepped-label"><span>01</span> selected work</div>
    <div class="proof-list">
      <article class="proof-row">
        <div class="proof-meta"><span class="dot dot-supply"></span>Supply chain</div>
        <div class="proof-copy">
          <h2>Decision systems for global operations</h2>
          <p>Work across visibility, risk, emissions, reporting, and operational decision-making — where multiple systems have to feel like one coherent product.</p>
          <a href="/#work">open case →</a>
        </div>
        <SystemThumb type="supply" />
      </article>
      <article class="proof-row">
        <div class="proof-meta"><span class="dot dot-health"></span>Healthcare</div>
        <div class="proof-copy">
          <h2>Software where correctness has human consequences</h2>
          <p>Experience in healthcare shaped how I think about reliability, clarity, constraints, and the cost of getting a workflow wrong.</p>
          <a href="/identity">trace the work →</a>
        </div>
        <SystemThumb type="health" />
      </article>
      <article class="proof-row" id="systems">
        <div class="proof-meta"><span class="dot dot-systems"></span>Systems</div>
        <div class="proof-copy">
          <h2>Architecture that survives the next order of magnitude</h2>
          <p>Distributed systems, APIs, event flows, PostgreSQL, Kafka, frontend federation, and the trade-offs required to keep complexity proportional to actual scale.</p>
          <a href="/identity">system notes →</a>
        </div>
        <SystemThumb type="platform" />
      </article>
    </div>
  </section>

  <section class="section shell rule compact-section">
    <div class="section-label stepped-label"><span>02</span> working principles</div>
    <div class="tui-principles">
      <div class="tui-row"><span class="tui-prompt">▲</span><strong>Make complexity earn its place.</strong><span>The sophisticated solution is not automatically the senior one.</span></div>
      <div class="tui-row"><span class="tui-prompt">▲</span><strong>Expose decisions, not org structure.</strong><span>Users should not have to understand your service boundaries.</span></div>
      <div class="tui-row"><span class="tui-prompt">▲</span><strong>Leadership is part of the system.</strong><span>Context, feedback, ownership, and incentives shape engineering output.</span></div>
      <div class="tui-row"><span class="tui-prompt">▲</span><strong>Taste compounds.</strong><span>Teams improve when they can explain why something is clear and useful.</span></div>
    </div>
  </section>

  <section class="section shell rule compact-section">
    <div class="section-label stepped-label"><span>03</span> field notes</div>
    <div class="writing-list">
      {notes.map((note) => <a class="writing-row" href={`/field-notes/${note.id}/`}>
        <div class="writing-date">{fmt(note.data.originallyWrittenAt ?? note.data.publishedAt)}</div>
        <div><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
        <div class="writing-tag">{note.data.tags[0] ?? 'note'}</div>
      </a>)}
    </div>
  </section>

  <section class="section shell rule compact-section closing-index">
    <div class="section-label stepped-label"><span>04</span> current thread</div>
    <div class="closing-grid">
      <p>AI-native engineering workflows, calmer decision interfaces, and ways to make engineering teams more capable without adding ceremony.</p>
      <a href="/identity">context →</a>
    </div>
  </section>
</BaseLayout>
