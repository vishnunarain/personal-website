---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const notes = (
  await getCollection("fieldNotes", ({ data }) => !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const lead = notes.find((note) => note.data.featured) ?? notes[0];
const rest = notes.filter((note) => note.id !== lead?.id);
---

<BaseLayout>
  <div class="shell front-page">
    {lead && (
      <article class="lead-story">
        <div class="issue-line">
          <span>
            <i></i> THE IMHOTEP DISPATCH
          </span>
          <span>FIELD NOTES FROM AN UNFINISHED WORLD</span>
        </div>
        <a
          class="cover-link"
          href={`/field-notes/${lead.id}/`}
          aria-label={`Read ${lead.data.title}`}
        >
          <div class="cover-art">
            <img
              src={lead.data.cover || "/images/imhotep-nile.webp"}
              width="1536"
              height="1024"
              alt={lead.data.coverAlt || "An illustrated dispatch from Imhotep"}
              fetchpriority="high"
            />
            <span class="cover-stamp">
              EST. A VERY
              <br />
              LONG TIME AGO
            </span>
          </div>
        </a>
        <div class="lead-copy">
          <div class="story-meta">
            <span>01 / THE POLYMATH PROBLEM</span>
            <span>AN ILLUSTRATED FABLE · 3 MIN READ</span>
          </div>
          <h1>
            <a href={`/field-notes/${lead.id}/`}>{lead.data.title}</a>
          </h1>
          <div class="lead-bottom">
            <p>{lead.data.description}</p>
            <a class="read-link" href={`/field-notes/${lead.id}/`}>
              Read the dispatch <span>↗</span>
            </a>
          </div>
        </div>
      </article>
    )}
    <section class="below-fold" aria-labelledby="more-title">
      <div class="section-heading">
        <h2 id="more-title">While the mortar dries</h2>
        <a href="/field-notes">All writing ↗</a>
      </div>
      <div class="reading-grid">
        {rest.map((note, i) => (
          <article class="story-preview">
            <span class="eyebrow">
              {String(i + 2).padStart(2, "0")} /{" "}
              {note.data.tags[0] || "FIELD NOTE"}
            </span>
            <h3>
              <a href={`/field-notes/${note.id}/`}>{note.data.title}</a>
            </h3>
            <p>{note.data.description}</p>
            <a class="text-link" href={`/field-notes/${note.id}/`}>
              Read the note ↗
            </a>
          </article>
        ))}
        <aside class="editor-note">
          <span class="eyebrow">A NOTE FROM THE SCRIBE</span>
          <h3>
            One head.
            <br />
            Too many hats.
          </h3>
          <p>
            Engineer, builder, incurably curious. This is a place to think out
            loud about the things we build—and why.
          </p>
          <a href="/identity">Meet the modern-day culprit ↗</a>
        </aside>
      </div>
    </section>
    <div class="closing-note">
      <span>☀</span>
      <p>
        Tomorrow: inventing a calendar.
        <br />
        <em>Apparently “soon” is not a delivery date.</em>
      </p>
      <a href="/imho">More from the margins →</a>
    </div>
  </div>
</BaseLayout>
