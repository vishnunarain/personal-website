---
import BaseLayout from "../layouts/BaseLayout.astro";
const takes = [
  [
    "On design",
    "A dashboard should help you make a decision. The database already knows what is in the database.",
  ],
  [
    "On engineering",
    "The sophisticated solution is not automatically the senior solution. Sometimes the answer is a smaller pyramid.",
  ],
  [
    "On AI",
    "An assistant that works very quickly in the wrong direction is still going in the wrong direction.",
  ],
  [
    "On teams",
    "If every decision needs the polymath, the polymath has built a queue.",
  ],
];
---

<BaseLayout title="Marginalia — imhotep">
  <section class="shell inner-page">
    <span class="eyebrow">IMHO / NOTES IN THE MARGIN</span>
    <h1>
      Strong opinions.
      <br />
      Erasable ink.
    </h1>
    <p class="page-deck">
      Things I think, use, and reserve the right to change my mind about.
    </p>
    <div class="marginalia-grid">
      {takes.map(([topic, take], i) => (
        <article>
          <span class="eyebrow">
            0{i + 1} / {topic}
          </span>
          <h2>{take}</h2>
        </article>
      ))}
    </div>
    <section id="setup" class="plain-section">
      <span class="eyebrow">THE WORKBENCH</span>
      <h2>Tools should earn their place.</h2>
      <p>
        Java, Vue, PostgreSQL, Kafka. A terminal, an editor, and a growing
        collection of AI experiments. The useful question is always: does this
        make the work clearer?
      </p>
    </section>
    <section id="models" class="plain-section">
      <span class="eyebrow">MODELS & MACHINES</span>
      <h2>Give the machine a job. Keep your judgement.</h2>
      <p>
        Choose a model for the task, give it the context, and decide how you
        will check its work before you ask it to begin.
      </p>
    </section>
  </section>
</BaseLayout>
