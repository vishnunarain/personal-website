---
import BaseLayout from "../layouts/BaseLayout.astro";
const work = [
  [
    "01",
    "Supply chain",
    "Making complicated operations legible.",
    "Connecting shipments, disruptions, orders, and operational decisions through software that people can understand and act on.",
  ],
  [
    "02",
    "Architecture",
    "Building for the next change.",
    "Frontend architecture, service boundaries, data ownership, and the decisions that keep a growing product manageable.",
  ],
  [
    "03",
    "Healthcare",
    "Care is in the details.",
    "Reliability, traceability, and interfaces where ambiguity has a cost. Lessons from building healthcare software.",
  ],
];
---

<BaseLayout title="The work — imhotep">
  <section class="shell inner-page">
    <span class="eyebrow">TEP / THINGS BUILT</span>
    <h1>Beyond the papyrus.</h1>
    <p class="page-deck">
      Engineering, product thinking, and the work of making complex systems
      useful.
    </p>
    <div class="work-list">
      {work.map(([n, domain, title, body]) => (
        <article id={n === "01" ? "decision-systems" : undefined}>
          <span class="eyebrow">
            {n} / {domain}
          </span>
          <div>
            <h2>{title}</h2>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
    <a class="read-link" href="/field-notes">
      Read the thinking behind the work ↗
    </a>
  </section>
</BaseLayout>
