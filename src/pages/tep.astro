---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('fieldNotes', ({data}) => !data.draft))
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0,5);
---
<BaseLayout title="tep — imhotep" description="Work, case studies, systems, and writing.">
  <div class="shell side-page tep-page">
    <header class="side-page-head">
      <div><span class="console-label">tep →</span><h1>The work: systems built, decisions made, lessons earned.</h1></div>
      <div class="side-key">press ← for imhotep</div>
    </header>

    <section class="case-ledger">
      <article id="decision-systems" class="case-entry">
        <div class="case-code">CASE / 01</div>
        <div>
          <h2>Decision systems for global operations</h2>
          <p>Making disruptions, shipments, orders, emissions, and operational state feel like one coherent product instead of an exposed service map.</p>
          <div class="case-facts"><span>product systems</span><span>architecture</span><span>leadership</span></div>
        </div>
        <a href="/field-notes">read related notes →</a>
      </article>

      <article class="case-entry">
        <div class="case-code">CASE / 02</div>
        <div>
          <h2>Architecture that can survive change</h2>
          <p>Service boundaries, orchestration, federation, caching, data ownership, and the discipline to keep complexity proportional to actual scale.</p>
          <div class="case-facts"><span>distributed systems</span><span>platform</span><span>frontend architecture</span></div>
        </div>
        <a href="/field-notes">read related notes →</a>
      </article>

      <article class="case-entry">
        <div class="case-code">CASE / 03</div>
        <div>
          <h2>Correctness as product design</h2>
          <p>Healthcare experience shaped how I think about reliability, traceability, usability, and the cost of ambiguous workflows.</p>
          <div class="case-facts"><span>healthcare</span><span>quality</span><span>systems</span></div>
        </div>
        <a href="/field-notes">read related notes →</a>
      </article>
    </section>

    <section class="tep-writing">
      <div class="home-reading-head"><span>writing</span><a href="/field-notes">all notes →</a></div>
      <div class="home-reading-list">
        {notes.map((note, index) => (
          <a href={`/field-notes/${note.id}/`}>
            <span>0{index + 1}</span>
            <div><strong>{note.data.title}</strong><small>{note.data.description}</small></div>
            <span>↗</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
