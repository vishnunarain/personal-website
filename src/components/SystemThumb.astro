---
const { type = 'supply' } = Astro.props;
---
<div class={`thumb thumb-${type}`} aria-hidden="true">
  <div class="grid"></div>
  {type === 'supply' && <>
    <div class="path path-accent" style="left:13%;top:30%;width:52%;transform:rotate(10deg)"></div>
    <div class="path" style="left:45%;top:39%;width:38%;transform:rotate(25deg)"></div>
    <span class="node node-accent" style="left:12%;top:28%"></span>
    <span class="node pulse node-accent" style="left:44%;top:37%"></span>
    <span class="node" style="left:79%;top:58%"></span>
    <div class="slide thumb-caption">signal → decision</div>
  </>}
  {type === 'health' && <>
    <div class="fade health-panel" style="left:12%;top:18%;width:24%;height:56%"></div>
    <div class="path path-accent" style="left:38%;top:46%;width:24%"></div>
    <div class="fade health-panel" style="right:12%;top:28%;width:25%;height:34%;animation-delay:.7s"></div>
    <span class="node pulse node-accent" style="left:50%;top:44%"></span>
  </>}
  {type === 'platform' && <>
    <div class="slide platform-block" style="left:12%;top:20%;animation-delay:0s"></div>
    <div class="slide platform-block" style="left:40%;top:20%;animation-delay:.4s"></div>
    <div class="slide platform-block" style="left:68%;top:20%;animation-delay:.8s"></div>
    <div class="platform-shell"></div>
  </>}
</div>
